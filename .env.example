# Runtime
NODE_ENV=development
LOG_LEVEL=info
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL: use separate LOGIN roles in deployed environments. The generic
# URLs remain a local-development fallback only.
DATABASE_URL=postgres://devmemoir:devmemoir@localhost:5432/devmemoir
DATABASE_DIRECT_URL=postgres://devmemoir:devmemoir@localhost:5432/devmemoir
# Production examples use LOGIN principals provisioned by the provider; the
# devmemoir_* capability roles created by the migration are NOLOGIN roles.
# Replace credentials through the provider secret manager; never commit them.
# DATABASE_API_URL=postgres://devmemoir_api_login:replace-me@localhost:5432/devmemoir
# DATABASE_WORKER_URL=postgres://devmemoir_worker_login:replace-me@localhost:5432/devmemoir
# DATABASE_QUEUE_URL=postgres://devmemoir_queue_login:replace-me@localhost:5432/devmemoir
# DATABASE_MIGRATIONS_URL=postgres://devmemoir_migrations_login:replace-me@localhost:5432/devmemoir
# The Web process calls the API and does not use a database URL in M1.
DATABASE_POOL_MAX=5

# Private GitHub App values. Never commit real values.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_WEBHOOK_SECRET_PREVIOUS=
GITHUB_API_VERSION=2022-11-28
OWNER_GITHUB_USER_ID=

# 32-byte base64 key used for transient auth/payload encryption.
ENCRYPTION_KEY_BASE64=
SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH_TRANSACTION_TTL_SECONDS=600
HANDOFF_TTL_SECONDS=120
SESSION_TTL_SECONDS=604800

# Optional browser/API behavior.
CSRF_HEADER=x-devmemoir-csrf
PORT=4000
HOST=127.0.0.1
